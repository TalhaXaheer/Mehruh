// MEHRUH Database Schema (PostgreSQL via Prisma)
// "SCENT. SOUL. MEMORY."

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  CUSTOMER
  ADMIN
  VIP
}

enum OrderStatus {
  PENDING
  PAID
  PREPARING
  DISPATCHED
  DELIVERED
  CANCELLED
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  image         String?
  passwordHash  String?
  role          Role      @default(CUSTOMER)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  orders        Order[]
  cart          Cart?
}

model Fragrance {
  id            String    @id @default(cuid())
  slug          String    @unique
  title         String
  subtitle      String
  description   String    @db.Text
  storyQuote    String    @db.Text
  family        String
  topNotes      String[]
  heartNotes    String[]
  baseNotes     String[]
  isFeatured    Boolean   @default(false)
  isBestseller  Boolean   @default(false)
  accentColor   String    @default("#4A1726")
  imageUrl      String
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  variants      FragranceVariant[]
  orderItems    OrderItem[]
  cartItems     CartItem[]
}

model FragranceVariant {
  id            String     @id @default(cuid())
  fragranceId   String
  fragrance     Fragrance  @relation(fields: [fragranceId], references: [id], onDelete: Cascade)
  size          String     // "50ml", "100ml", "Discovery Set"
  priceInCents  Int
  inventory     Int        @default(100)
  stripePriceId String?

  cartItems     CartItem[]
  orderItems    OrderItem[]
}

model Cart {
  id        String     @id @default(cuid())
  userId    String?    @unique
  user      User?      @relation(fields: [userId], references: [id], onDelete: Cascade)
  items     CartItem[]
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
}

model CartItem {
  id          String           @id @default(cuid())
  cartId      String
  cart        Cart             @relation(fields: [cartId], references: [id], onDelete: Cascade)
  fragranceId String
  fragrance   Fragrance        @relation(fields: [fragranceId], references: [id])
  variantId   String
  variant     FragranceVariant @relation(fields: [variantId], references: [id])
  quantity    Int              @default(1)
  createdAt   DateTime         @default(now())
}

model Order {
  id              String      @id @default(cuid())
  orderNumber     String      @unique
  userId          String?
  user            User?       @relation(fields: [userId], references: [id])
  status          OrderStatus @default(PENDING)
  totalAmount     Int
  shippingAddress Json
  stripePaymentId String?     @unique
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  items           OrderItem[]
}

model OrderItem {
  id          String           @id @default(cuid())
  orderId     String
  order       Order            @relation(fields: [orderId], references: [id], onDelete: Cascade)
  fragranceId String
  fragrance   Fragrance        @relation(fields: [fragranceId], references: [id])
  variantId   String
  variant     FragranceVariant @relation(fields: [variantId], references: [id])
  quantity    Int
  pricePaid   Int
}

model NewsletterSubscriber {
  id           String   @id @default(cuid())
  email        String   @unique
  subscribedAt DateTime @default(now())
  isActive     Boolean  @default(true)
}
